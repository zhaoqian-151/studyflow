APP_NAME=StudyFlow
# Run python scripts/setup_postgres.py to generate a local password.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://studyflow:${POSTGRES_PASSWORD}@127.0.0.1:5433/studyflow
COOKIE_SECURE=false
# OpenAI-compatible chat API; empty key enables explicit local rule mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_LIMIT=50
# Optional embeddings. Without these, knowledge search uses local BM25.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
